{
  "id": "project-zomboid",
  "name": "Project Zomboid Dedicated Server",
  "author": "The Indie Stone & SteamCMD",
  "category": "Survie Zombie Hardcore",
  "icon": "🧟‍♂️",
  "tagline": "L'ultime simulateur de survie apocalypse zombie en multijoueur",
  "description": "Serveur dédié officiel Project Zomboid via SteamCMD avec génération de monde persistant Knox County, simulation météorologique poussée, cycle jour/nuit et gestion des mods du Workshop.",
  "icon_url": "https://raw.githubusercontent.com/Chomiam/noos_nas_eggs/main/eggs/project-zomboid/icon.png",
  "banner_url": "https://raw.githubusercontent.com/Chomiam/noos_nas_eggs/main/eggs/project-zomboid/banner.jpg",
  "steam_app_id": "380870",
  "docker_image": "ghcr.io/parkervcp/steamcmd:debian",
  "default_port": 16261,
  "port_protocol": "udp",
  "extra_ports": [
    {
      "port": 16262,
      "protocol": "udp",
      "description": "Port direct joueur 1"
    }
  ],
  "default_memory_mb": 4096,
  "min_memory_mb": 2048,
  "startup_cmd": "./start-server.sh -servername \"{{SERVER_NAME}}\" -adminpassword \"{{ADMIN_PASSWORD}}\"",
  "variables": [
    {
      "name": "Nom du serveur",
      "env_variable": "SERVER_NAME",
      "description": "Nom du serveur Project Zomboid",
      "default_value": "Noos NAS Zomboid",
      "input_type": "text",
      "options": null
    },
    {
      "name": "Mot de passe Administrateur",
      "env_variable": "ADMIN_PASSWORD",
      "description": "Mot de passe du compte administrateur admin",
      "default_value": "NoosAdminZomboid!",
      "input_type": "password",
      "options": null
    },
    {
      "name": "Joueurs Maximum",
      "env_variable": "MAX_PLAYERS",
      "description": "Nombre maximum de survivants",
      "default_value": "16",
      "input_type": "number",
      "options": null
    }
  ],
  "is_custom": false
}