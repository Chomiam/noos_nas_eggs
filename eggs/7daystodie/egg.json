{
  "id": "7daystodie",
  "name": "7 Days to Die Dedicated Server",
  "author": "The Fun Pimps & SteamCMD",
  "category": "Survie / Post-Apocalyptique",
  "icon": "🧟",
  "tagline": "Survivez à la horde du 7ème jour dans un monde voxel hostile",
  "description": "Serveur dédié officiel 7 Days to Die (V1.0+ / Alpha) avec support SteamCMD automatique, persistance du monde de survie horde, configuration XML assistée et console d'administration.",
  "icon_url": "https://raw.githubusercontent.com/Chomiam/steve_nas_eggs/main/eggs/7daystodie/icon.png",
  "banner_url": "https://raw.githubusercontent.com/Chomiam/steve_nas_eggs/main/eggs/7daystodie/banner.jpg",
  "steam_app_id": "294420",
  "docker_image": "ghcr.io/parkervcp/steamcmd:debian",
  "default_port": 26900,
  "port_protocol": "both",
  "extra_ports": [
    {
      "port": 26901,
      "protocol": "udp",
      "description": "Port de requête Steam Query 1"
    },
    {
      "port": 26902,
      "protocol": "udp",
      "description": "Port de requête Steam Query 2"
    },
    {
      "port": 8081,
      "protocol": "tcp",
      "description": "Port console Telnet local"
    }
  ],
  "default_memory_mb": 8192,
  "min_memory_mb": 4096,
  "startup_cmd": "./7DaysToDieServer.x86_64 -logfile /home/container/logs/latest.log -quit -batchmode -nographics -dedicated -configfile=serverconfig.xml",
  "variables": [
    {
      "name": "Nom du serveur",
      "env_variable": "SERVER_NAME",
      "description": "Nom affiché dans la liste des serveurs multijoueur 7DTD",
      "default_value": "Serveur 7 Days to Die STEvE_OS",
      "input_type": "text",
      "options": null
    },
    {
      "name": "Mot de passe Joueurs (Optionnel)",
      "env_variable": "SERVER_PASSWORD",
      "description": "Mot de passe requis pour rejoindre (laisser vide si public)",
      "default_value": "",
      "input_type": "password",
      "options": null
    },
    {
      "name": "Mot de passe Administrateur (Telnet)",
      "env_variable": "ADMIN_PASSWORD",
      "description": "Mot de passe de gestion console / Telnet",
      "default_value": "SteveAdminPass123!",
      "input_type": "password",
      "options": null
    },
    {
      "name": "Monde de jeu (Game World)",
      "env_variable": "GAME_WORLD",
      "description": "Monde officiel ou génération procédurale RWG",
      "default_value": "Navezgane",
      "input_type": "select",
      "options": [
        "Navezgane",
        "PREGEN01",
        "PREGEN02",
        "PREGEN03",
        "RWG"
      ]
    },
    {
      "name": "Nom de la sauvegarde (Game Name)",
      "env_variable": "GAME_NAME",
      "description": "Nom unique du dossier de sauvegarde de la partie",
      "default_value": "SteveWorld",
      "input_type": "text",
      "options": null
    },
    {
      "name": "Nombre maximum de joueurs",
      "env_variable": "MAX_PLAYERS",
      "description": "Nombre maximum de joueurs simultanés",
      "default_value": "8",
      "input_type": "number",
      "options": null
    },
    {
      "name": "Difficulté (0-5)",
      "env_variable": "GAME_DIFFICULTY",
      "description": "0=Pillard, 1=Aventurier, 2=Nomade (Normal), 3=Guerrier, 4=Survivaliste, 5=Dément",
      "default_value": "2",
      "input_type": "select",
      "options": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    {
      "name": "Port Telnet (Console)",
      "env_variable": "TELNET_PORT",
      "description": "Port de gestion Telnet local",
      "default_value": "8081",
      "input_type": "number",
      "options": null
    }
  ],
  "is_custom": false
}