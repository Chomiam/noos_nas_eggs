{
  "id": "minecraft-bedrock",
  "name": "Minecraft: Bedrock Edition",
  "author": "Mojang & Noos NAS",
  "category": "Bac à sable / Survie",
  "icon": "🧱",
  "tagline": "Serveur officiel Mojang BDS pour consoles, smartphones et Windows 10/11",
  "description": "Serveur dédié officiel Mojang BDS (Bedrock Dedicated Server) permettant le jeu croisé (cross-play) entre consoles (Nintendo Switch, PS4/PS5, Xbox), mobiles (iOS, Android) et PC Windows 10/11.",
  "icon_url": "https://raw.githubusercontent.com/Chomiam/noos_nas_eggs/main/eggs/minecraft-bedrock/icon.svg",
  "banner_url": "https://raw.githubusercontent.com/Chomiam/noos_nas_eggs/main/eggs/minecraft-bedrock/banner.png",
  "steam_app_id": null,
  "docker_image": "ghcr.io/parkervcp/yolks:ubuntu",
  "default_port": 19132,
  "port_protocol": "udp",
  "extra_ports": [],
  "default_memory_mb": 2048,
  "min_memory_mb": 1024,
  "startup_cmd": "LD_LIBRARY_PATH=. ./bedrock_server",
  "variables": [
    {
      "name": "Nom du serveur",
      "env_variable": "SERVER_NAME",
      "description": "Nom affiché aux joueurs Bedrock",
      "default_value": "Noos NAS Bedrock World",
      "input_type": "text",
      "options": null
    },
    {
      "name": "Mode de jeu",
      "env_variable": "GAMEMODE",
      "description": "Mode par défaut des nouveaux joueurs",
      "default_value": "survival",
      "input_type": "select",
      "options": [
        "survival",
        "creative",
        "adventure"
      ]
    },
    {
      "name": "Difficulté",
      "env_variable": "DIFFICULTY",
      "description": "Difficulté du monde Bedrock",
      "default_value": "normal",
      "input_type": "select",
      "options": [
        "peaceful",
        "easy",
        "normal",
        "hard"
      ]
    }
  ],
  "is_custom": false
}