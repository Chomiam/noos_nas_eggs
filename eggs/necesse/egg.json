{
  "id": "necesse",
  "name": "Necesse Dedicated Server",
  "author": "Mads Skovgaard & FairPlay Studios",
  "category": "Aventure / Action-RPG",
  "icon": "🗡️",
  "tagline": "Explorez des îles infinies, recrutez des colons et battez des boss légendaires",
  "description": "Serveur dédié officiel pour Necesse avec monde procédural infini, gestion de colonies de PNJ automatisées et combats coopératifs.",
  "icon_url": "https://raw.githubusercontent.com/Chomiam/noos_nas_eggs/main/eggs/necesse/icon.png",
  "banner_url": "https://raw.githubusercontent.com/Chomiam/noos_nas_eggs/main/eggs/necesse/banner.jpg",
  "steam_app_id": "1169370",
  "docker_image": "ghcr.io/parkervcp/steamcmd:debian",
  "default_port": 14159,
  "port_protocol": "udp",
  "extra_ports": [],
  "default_memory_mb": 3072,
  "min_memory_mb": 1024,
  "startup_cmd": "./jre/bin/java -Xms128M -Xmx{{SERVER_MEMORY}}M -Dterminal.jline=false -Dterminal.ansi=true -jar Server.jar -localdir -nogui -world {{WORLD_NAME}} -port {{SERVER_PORT}}",
  "variables": [
    {
      "name": "Nom du monde",
      "env_variable": "WORLD_NAME",
      "description": "Nom du fichier de sauvegarde",
      "default_value": "MondeNoos",
      "input_type": "text",
      "options": null
    },
    {
      "name": "Mot de passe serveur",
      "env_variable": "SERVER_PASSWORD",
      "description": "Mot de passe de protection",
      "default_value": "",
      "input_type": "password",
      "options": null
    },
    {
      "name": "Nombre maximum de colons/joueurs",
      "env_variable": "MAX_PLAYERS",
      "description": "Nombre de joueurs autorisés",
      "default_value": "10",
      "input_type": "number",
      "options": null
    }
  ],
  "is_custom": false
}
